# Metabase connection (same key your hybrid agent uses)
METABASE_URL=https://metabase.ohc.network
METABASE_API_KEY=your_metabase_api_key_here
METABASE_DATABASE_ID=3

# LLM (Gemini free tier, via its OpenAI-compatible endpoint) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
